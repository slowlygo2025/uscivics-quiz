# Resend — contact form (https://resend.com/api-keys)
# 1. Create API key
# 2. Verify sending domain (or use onboarding@resend.dev for tests only)
# 3. Copy to secrets/resend.env and run: npm run resend:push-env

RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO=contact@uscivics-quiz.com
# After domain verify, prefer:
# CONTACT_FROM=USCivics Quiz <contact@uscivics-quiz.com>
CONTACT_FROM=USCivics Quiz <onboarding@resend.dev>
