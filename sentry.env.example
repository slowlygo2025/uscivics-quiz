# Fill this file → copy to secrets/sentry.env (gitignored), then:
#   npm run sentry:push-env
#
# Create token: https://de.sentry.io/settings/auth-tokens/
#   Name: uscivics-vercel-releases
#   Scopes: org:read, project:read, project:releases
#
# Slugs: open your project in Sentry — URL looks like
#   https://de.sentry.io/settings/<ORG>/projects/<PROJECT>/

SENTRY_URL=https://de.sentry.io
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
