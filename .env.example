# Firebase Analytics (client) — usage metrics after cookie "Accept all"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Sentry error monitoring (client + server). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map + release upload on build (Vercel/CI secrets — never commit)
# EU region uses https://de.sentry.io — copy from secrets/sentry.env.example
SENTRY_URL=https://de.sentry.io
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: path override for GSC Indexing scripts (default: secrets/gsc-service-account.json)
# GSC_SERVICE_ACCOUNT_PATH=

# Vercel Cron auth (Vercel injects Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# GSC service account JSON as a single-line string (Vercel env — for /api/cron/seo)
# Paste contents of secrets/gsc-service-account.json
# GSC_SERVICE_ACCOUNT_JSON=

# Optional SEO cron knobs
# SEO_CRON_T2_BUDGET=40
# SEO_CRON_SKIP_INDEX=1
# NEXT_PUBLIC_SITE_URL=https://uscivics-quiz.com
