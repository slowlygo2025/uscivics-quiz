# Contact form (Resend). Without RESEND_API_KEY the form offers mailto fallback.
RESEND_API_KEY=
# CONTACT_TO=contact@uscivics-quiz.com
# CONTACT_FROM=USCivics Quiz <onboarding@resend.dev>

# Optional durable rate limits for /api/contact and /api/officials (Upstash Redis REST).
# Without these, limits fall back to in-memory per serverless instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Firebase Analytics (client) — usage metrics after cookie "Accept all"
# Enable Auth + Firestore in the same Firebase project for optional cloud sync.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Sentry error monitoring (client + server). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map + release upload on build (Vercel/CI secrets — never commit)
# EU region uses https://de.sentry.io — copy from secrets/sentry.env.example
SENTRY_URL=https://de.sentry.io
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: path override for GSC Indexing scripts (default: secrets/gsc-service-account.json)
# GSC_SERVICE_ACCOUNT_PATH=

# Vercel Cron auth (Vercel injects Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# GSC service account JSON as a single-line string (Vercel env — for /api/cron/seo)
# Paste contents of secrets/gsc-service-account.json
# GSC_SERVICE_ACCOUNT_JSON=

# Optional SEO cron knobs
# SEO_CRON_T2_BUDGET=40
# SEO_CRON_SKIP_INDEX=1
# NEXT_PUBLIC_SITE_URL=https://uscivics-quiz.com

# Phase 1 affiliates — Amazon Associates tag (optional; links work without it)
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Monetag Multitag (zone 266272 = Push + Vignette + In-Page Push + Popunder).
# Keep OFF while Google Ads Search CPA / landing trust are the priority.
# Domain verification meta stays in layout without loading ads.
# NEXT_PUBLIC_MONETAG_ENABLED=true

# Google Ads API — store real values only in secrets/google-ads.env (gitignored)
# See ads/SETUP.md and ads/google-ads.env.example
